---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";
import { withBase } from "../lib/paths";
import { formatPostDate, getDisplayTags } from "../lib/postMeta";

const posts = (await getCollection("posts"))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const featured = posts.filter((post) => post.data.featured).slice(0, 3);
const articleLikeSlugs = new Set(posts.filter((post) => post.data.kind === "writing").map((post) => post.slug));
const activityPosts = posts.filter((post) => !articleLikeSlugs.has(post.slug)).slice(0, 4);
const articlePosts = posts.filter((post) => articleLikeSlugs.has(post.slug)).slice(0, 4);
---

<BaseLayout title={`実績と記事 | ${profile.title}`} description={profile.intro}>
  <section class="hero home-hero">
    <div class="hero-title">
      <p class="eyebrow">{profile.title}</p>
      <h1><span class="marker">{profile.name}</span></h1>
      <div class="hero-actions">
        <a class="button primary" href="#latest-posts">新着記事</a>
        <a class="button ghost" href="#works">実績一覧</a>
        {profile.links.map((link) => (
          <a class="button ghost" href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
        ))}
      </div>
    </div>
    <p class="speech lead">
      <svg class="speech-tail" aria-hidden="true" width="30" height="28" viewBox="0 0 30 28"><path d="M30 4 Q 14 8 1 3 Q 10 14 30 22" /></svg>
      <svg class="speech-lines" aria-hidden="true" width="26" height="26" viewBox="0 0 26 26"><path d="M4 16 L10 18" /><path d="M8 6 L13 13" /><path d="M19 2 L18 10" /></svg>
      {profile.intro}
    </p>
  </section>

  <section class="latest-strip" id="latest-posts">
    <div class="strip-head">
      <h2 class="section-title">
        <span class="section-num">1</span>
        <span class="section-name">新着記事</span>
        <span class="eyebrow">最近追加</span>
      </h2>
      <a class="text-link note-arrow" href={withBase("/posts/")}>一覧を見る<svg aria-hidden="true" width="44" height="18" viewBox="0 0 44 18"><path d="M2 12 C 14 4, 28 4, 40 9" /><path d="M33 4 L40 9 L33 13" /></svg></a>
    </div>
    <div class="latest-rail-wrap">
      <div class="latest-rail">
      {featured.map((post) => (
        <article class="feature-card rail-card" data-kind={post.data.kind}>
          <time class="feature-date" datetime={post.data.publishedAt.toISOString()}>
            {formatPostDate(post.data)}
          </time>
          <h3><a href={withBase(`/posts/${post.slug}/`)}>{post.data.title}</a></h3>
          <p class="card-summary">{post.data.summary}</p>
          <div class="tag-row">
            {getDisplayTags(post.data).map((tag) => (
              <span class="pill neutral">{tag}</span>
            ))}
          </div>
        </article>
      ))}
      </div>
    </div>
  </section>

  <section class="works-stage" id="works">
    <div class="works-stage-head">
      <h2 class="section-title">
        <span class="section-num">2</span>
        <span class="section-name">やったこと</span>
        <span class="eyebrow">参加したもの</span>
      </h2>
      <a class="text-link note-arrow" href={withBase("/posts/")}>すべて見る<svg aria-hidden="true" width="44" height="18" viewBox="0 0 44 18"><path d="M2 12 C 14 4, 28 4, 40 9" /><path d="M33 4 L40 9 L33 13" /></svg></a>
    </div>
    <div class="works-grid-wrap note-board">
      <div class="works-grid activity-grid">
      {activityPosts.map((post) => (
        <div class="work-item">
          <a class="work-card" href={withBase(`/posts/${post.slug}/`)} data-kind={post.data.kind}>
            <time class="feature-date" datetime={post.data.publishedAt.toISOString()}>
              {formatPostDate(post.data)}
            </time>
            <h3>{post.data.title}</h3>
            <div class="tag-row">
              {getDisplayTags(post.data).map((tag) => (
                <span class="pill neutral">{tag}</span>
              ))}
            </div>
          </a>
          {post.data.role && (
            <p class="role-bubble">
              <svg class="role-tail" aria-hidden="true" width="26" height="22" viewBox="0 0 26 22"><path d="M3 22 Q 5 10 1 1 Q 13 9 21 22" /></svg>
              <svg class="role-lines" aria-hidden="true" width="18" height="18" viewBox="0 0 18 18"><path d="M2 8 L7 10" /><path d="M5 2 L9 7" /><path d="M12 1 L12 6" /></svg>
              <span class="role-label">担当</span>
              {post.data.role}
            </p>
          )}
        </div>
      ))}
      </div>
    </div>
  </section>

  <section class="writing-stage">
    <span class="box-label">書いたもの</span>
    <div class="works-stage-head">
      <h2 class="section-title">
        <span class="section-num">3</span>
        <span class="section-name">担当した記事</span>
      </h2>
      <a class="text-link note-arrow" href={withBase("/posts/")}>一覧を見る<svg aria-hidden="true" width="44" height="18" viewBox="0 0 44 18"><path d="M2 12 C 14 4, 28 4, 40 9" /><path d="M33 4 L40 9 L33 13" /></svg></a>
    </div>
    <div class="works-grid writing-grid">
    {articlePosts.map((post) => (
      <a class="article-card" href={withBase(`/posts/${post.slug}/`)} data-kind={post.data.kind}>
        <time class="feature-date" datetime={post.data.publishedAt.toISOString()}>
          {formatPostDate(post.data)}
        </time>
        <h3>{post.data.title}</h3>
        <p class="article-stack">{getDisplayTags(post.data).join(" ・ ")}</p>
      </a>
    ))}
    </div>
  </section>

  <style>
    .home-hero {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 24px 40px;
      padding: 18px 0;
    }

    .works-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }

    .hero-title,
    .feature-card,
    .work-card,
    .article-card {
      display: grid;
      gap: 10px;
    }

    .hero-title h1 {
      max-width: none;
    }

    .speech {
      position: relative;
      flex: 0 1 380px;
      margin-left: 20px;
      padding: 18px 22px;
      color: var(--text);
      background: white;
      border: 2px solid #1f2937;
      border-radius: 28px;
      box-shadow: 5px 5px 0 rgba(31, 79, 160, 0.2);
      transform: rotate(-1deg);
    }

    .speech-tail {
      position: absolute;
      left: -27px;
      top: 30px;
      overflow: visible;
    }

    .speech-tail path {
      fill: white;
      stroke: #1f2937;
      stroke-width: 2;
      stroke-linejoin: round;
    }

    .speech::before {
      content: "";
      position: absolute;
      left: -2px;
      top: 35px;
      width: 4px;
      height: 16px;
      background: white;
    }

    .speech-lines,
    .role-lines {
      position: absolute;
      fill: none;
      stroke-linecap: round;
    }

    .speech-lines {
      top: -18px;
      right: -14px;
      stroke: var(--cover);
      stroke-width: 2;
    }

    .latest-strip,
    .works-stage,
    .writing-stage {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
    }

    .strip-head,
    .works-stage-head {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      justify-content: space-between;
      gap: 12px;
    }

    .section-title {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: clamp(1.3rem, 2vw, 1.5rem);
      line-height: 1.3;
    }

    .section-num {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      background: var(--cover);
      color: white;
      font-size: 1rem;
    }

    .section-name {
      padding-bottom: 2px;
      border-bottom: 4px double var(--cover);
    }

    .section-title .eyebrow {
      font-weight: 400;
    }

    .note-arrow {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.88rem;
    }

    .note-arrow::after {
      display: none;
    }

    .note-arrow svg {
      fill: none;
      stroke: currentColor;
      stroke-width: 1.5;
      stroke-linecap: round;
    }

    .card-summary {
      color: var(--muted);
      font-size: 0.84rem;
      line-height: 1.75;
    }

    .latest-rail {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: minmax(260px, 1fr);
      gap: 18px;
      overflow-x: auto;
      padding: 8px 2px 10px;
      scroll-snap-type: x proximity;
      scrollbar-width: thin;
    }

    .feature-card,
    .work-card {
      border: 1px solid var(--line);
      box-shadow: var(--shadow);
    }

    .feature-card {
      --tape-bg: var(--tape-intern-bg);
      --tape-border: var(--tape-intern-border);
      position: relative;
      padding: 36px 16px 16px;
      background: rgba(255, 255, 255, 0.94);
      transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
    }

    .work-card {
      --pin-color: var(--tape-intern-bg);
      --pin-ring: var(--tape-intern-border);
      position: relative;
      padding: 28px 16px 16px;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0.84));
      transform-origin: center 18px;
      transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
    }

    .feature-card::before {
      content: "";
      position: absolute;
      top: 14px;
      left: 18px;
      width: 40px;
      height: 12px;
      background: var(--tape-bg);
      border: 1px solid var(--tape-border);
      transform: rotate(-4deg);
    }

    .work-card::before,
    .work-card::after {
      content: "";
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
    }

    .work-card::before {
      top: 8px;
      width: 14px;
      height: 14px;
      border-radius: 999px;
      background:
        radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.9), transparent 34%),
        var(--pin-color);
      border: 1px solid var(--pin-ring);
      box-shadow:
        0 2px 0 0 rgba(255, 255, 255, 0.55) inset,
        0 3px 8px var(--pin-metal-shadow);
      z-index: 2;
    }

    .work-card::after {
      top: 18px;
      width: 18px;
      height: 8px;
      border-radius: 999px;
      background:
        radial-gradient(circle at center, var(--pin-hole) 0 28%, transparent 72%);
      opacity: 0.9;
    }

    .feature-card:nth-child(2n) {
      transform: rotate(-0.45deg);
    }

    .feature-card:nth-child(3n) {
      transform: rotate(0.45deg);
    }

    .work-item:nth-child(3n + 2) .work-card {
      transform: rotate(-0.65deg);
    }

    .work-item:nth-child(3n) .work-card {
      transform: rotate(0.65deg);
    }

    .feature-card:nth-child(2n)::before {
      transform: rotate(4deg);
    }

    .feature-card[data-kind="intern"],
    .work-card[data-kind="intern"] {
      --tape-bg: var(--tape-intern-bg);
      --tape-border: var(--tape-intern-border);
      --pin-color: var(--tape-intern-bg);
      --pin-ring: var(--tape-intern-border);
    }

    .feature-card[data-kind="lab"],
    .work-card[data-kind="lab"] {
      --tape-bg: var(--tape-lab-bg);
      --tape-border: var(--tape-lab-border);
      --pin-color: var(--tape-lab-bg);
      --pin-ring: var(--tape-lab-border);
    }

    .feature-card[data-kind="project"],
    .work-card[data-kind="project"] {
      --tape-bg: var(--tape-project-bg);
      --tape-border: var(--tape-project-border);
      --pin-color: var(--tape-project-bg);
      --pin-ring: var(--tape-project-border);
    }

    .feature-card[data-kind="writing"],
    .work-card[data-kind="writing"] {
      --tape-bg: var(--tape-writing-bg);
      --tape-border: var(--tape-writing-border);
      --pin-color: var(--tape-writing-bg);
      --pin-ring: var(--tape-writing-border);
    }

    .feature-card:hover,
    .work-card:hover,
    .work-item .work-card:hover {
      transform: translateY(-2px) rotate(0deg);
      border-color: rgba(37, 99, 235, 0.3);
      box-shadow: 0 16px 36px rgba(15, 23, 42, 0.08);
    }

    .rail-card {
      scroll-snap-align: start;
      min-height: 100%;
    }

    .feature-date {
      color: var(--muted);
      font-size: 0.84rem;
    }

    .activity-grid {
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 40px 18px;
      align-items: start;
    }

    .work-item {
      display: grid;
      gap: 14px;
    }

    .role-bubble {
      position: relative;
      margin: 8px 0 0 14px;
      padding: 18px 14px 12px;
      background: white;
      border: 1.5px solid #6b5d1c;
      border-radius: 18px 18px 18px 4px;
      box-shadow: 3px 3px 0 rgba(107, 93, 28, 0.22);
      font-size: 0.82rem;
      line-height: 1.7;
      transform: rotate(-0.8deg);
    }

    .role-tail {
      position: absolute;
      top: -20px;
      left: 26px;
      overflow: visible;
    }

    .role-tail path {
      fill: white;
      stroke: #6b5d1c;
      stroke-width: 1.5;
      stroke-linejoin: round;
    }

    .role-bubble::before {
      content: "";
      position: absolute;
      top: -1.5px;
      left: 30px;
      width: 16px;
      height: 3px;
      background: white;
    }

    .role-lines {
      top: -14px;
      left: -12px;
      stroke: #6b5d1c;
      stroke-width: 1.5;
    }

    .role-label {
      position: absolute;
      top: -11px;
      right: 12px;
      padding: 1px 9px;
      background: var(--cover);
      color: white;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      line-height: 1.6;
      transform: rotate(2deg);
      box-shadow: 1px 1px 0 rgba(0, 0, 0, 0.15);
    }

    .writing-stage {
      position: relative;
      margin-top: 16px;
      padding: 40px 22px 24px;
      border: 2px dashed var(--cover);
      border-radius: 6px;
      background: rgba(253, 253, 251, 0.7);
    }

    .box-label {
      position: absolute;
      top: -16px;
      left: 20px;
      padding: 4px 14px;
      background: var(--cover);
      color: white;
      font-size: 0.8rem;
      font-weight: 700;
    }

    .writing-grid {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 18px;
    }

    .article-card {
      gap: 8px;
      padding: 16px;
      background: white;
      border: 1px solid var(--line);
      transition: transform 180ms ease, border-color 180ms ease;
    }

    .article-card:hover {
      transform: translateY(-2px);
      border-color: rgba(37, 99, 235, 0.3);
    }

    .article-stack {
      color: #1c3f80;
      font-size: 0.76rem;
    }

    @media (max-width: 900px) {
      .works-grid {
        grid-template-columns: 1fr;
      }

      .feature-card:nth-child(2n),
      .feature-card:nth-child(3n),
      .work-item:nth-child(3n + 2) .work-card,
      .work-item:nth-child(3n) .work-card {
        transform: none;
      }
    }

    @media (max-width: 640px) {
      .speech {
        margin-left: 22px;
      }

      .writing-stage {
        padding: 36px 12px 16px;
      }
    }
  </style>
</BaseLayout>
