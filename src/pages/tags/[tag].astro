---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/paths";
import { formatPostDate, getDisplayTagPath, getDisplayTags } from "../../lib/postMeta";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const tags = [...new Set(posts.flatMap((post) => getDisplayTags(post.data)))];

  return tags.map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const posts = (await getCollection("posts"))
  .filter((post) => getDisplayTags(post.data).includes(tag || ""))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<BaseLayout title={`#${tag} | Portfolio`} description={`#${tag} の関連実績一覧です。`}>
  <section class="page-intro">
    <div>
      <a class="text-link" href={withBase("/posts/")}>← 実績一覧へ戻る</a>
      <p class="eyebrow">Tag</p>
      <h1><span class="marker">#{tag}</span></h1>
      <p class="lead">関連する実績だけをまとめています。</p>
    </div>
    <div class="intro-aside">
      <p class="stat-label">Matches</p>
      <p class="stat-value">{posts.length}</p>
    </div>
  </section>

  <section class="work-ledger">
    {posts.map((post) => (
      <article class="ledger-row tag-ledger-row" data-kind={post.data.kind}>
        <div class="ledger-row-main">
          <div class="meta-row">
            <time datetime={post.data.publishedAt.toISOString()}>{formatPostDate(post.data)}</time>
          </div>
          <h2><a href={withBase(`/posts/${post.slug}/`)}>{post.data.title}</a></h2>
          <div class="tag-row">
            {getDisplayTags(post.data).map((item) => (
              <a class={`pill neutral ${item === tag ? "active-tag" : ""}`} href={withBase(getDisplayTagPath(item))}>{item}</a>
            ))}
          </div>
        </div>
      </article>
    ))}
  </section>

  <style>
    .tag-ledger-row {
      position: relative;
      grid-template-columns: 1fr;
      padding-top: 30px;
      background: rgba(255, 255, 255, 0.94);
    }

    .tag-ledger-row::before {
      content: "";
      position: absolute;
      top: 12px;
      left: 18px;
      width: 40px;
      height: 12px;
      background: var(--tape-bg, var(--tape-lab-bg));
      border: 1px solid var(--tape-border, var(--tape-lab-border));
      transform: rotate(-4deg);
    }

    .tag-ledger-row[data-kind="intern"] { --tape-bg: var(--tape-intern-bg); --tape-border: var(--tape-intern-border); }
    .tag-ledger-row[data-kind="lab"] { --tape-bg: var(--tape-lab-bg); --tape-border: var(--tape-lab-border); }
    .tag-ledger-row[data-kind="project"] { --tape-bg: var(--tape-project-bg); --tape-border: var(--tape-project-border); }
    .tag-ledger-row[data-kind="writing"] { --tape-bg: var(--tape-writing-bg); --tape-border: var(--tape-writing-border); }

    .tag-ledger-row:nth-child(2n) {
      transform: rotate(-0.25deg);
    }

    .active-tag {
      border-color: rgba(37, 99, 235, 0.28);
      background: rgba(37, 99, 235, 0.1);
    }
  </style>
</BaseLayout>
