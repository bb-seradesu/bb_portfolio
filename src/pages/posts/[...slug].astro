---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/paths";
import { formatPostDate, getDisplayTagPath, getDisplayTags } from "../../lib/postMeta";

export async function getStaticPaths() {
  const posts = await getCollection("posts");

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | Portfolio`} description={post.data.summary}>
  <article class="article-shell">
    <a class="text-link" href={withBase("/posts/")}>← 実績一覧へ戻る</a>
    <header class="article-header article-hero">
      <div class="hero-meta">
        <p class="eyebrow">Article</p>
        <time datetime={post.data.publishedAt.toISOString()}>
          {formatPostDate(post.data)}
        </time>
      </div>
      <h1><span class="marker">{post.data.title}</span></h1>
      <div class="tag-row">
        {getDisplayTags(post.data).map((tag) => (
          <a class="pill neutral tag-chip" href={withBase(getDisplayTagPath(tag))}>{tag}</a>
        ))}
      </div>
      {post.data.sourceUrl && (
        <a class="button ghost" href={post.data.sourceUrl} target="_blank" rel="noreferrer">記事リンクを見る</a>
      )}
    </header>

    <div class="article-body">
      <section class="prose">
        <Content />
      </section>
      {(post.data.period || post.data.role || post.data.outcome || post.data.stack.length > 0) && (
        <dl class="memo-card">
          {post.data.period && (<><dt>期間</dt><dd>{post.data.period}</dd></>)}
          {post.data.role && (<><dt>担当</dt><dd>{post.data.role}</dd></>)}
          {post.data.outcome && (<><dt>成果</dt><dd>{post.data.outcome}</dd></>)}
          {post.data.stack.length > 0 && (<><dt>技術</dt><dd>{post.data.stack.join("、")}</dd></>)}
        </dl>
      )}
    </div>
  </article>

  <style>
    .article-hero {
      position: relative;
      gap: 14px;
      padding: 36px 18px 18px;
      border: 1px solid var(--line);
      background: rgba(255, 255, 255, 0.94);
      box-shadow: var(--shadow);
    }

    .article-hero::before {
      content: "";
      position: absolute;
      top: 14px;
      left: 18px;
      width: 40px;
      height: 12px;
      background: var(--tape-writing-bg);
      border: 1px solid var(--tape-writing-border);
      transform: rotate(-4deg);
    }

    .article-hero h1 {
      max-width: 28em;
      font-size: clamp(1.5rem, 3vw, 2.1rem);
      line-height: 1.45;
      text-wrap: balance;
    }

    .article-hero h1 .marker {
      -webkit-box-decoration-break: clone;
      box-decoration-break: clone;
    }

    .article-body {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(220px, 300px);
      align-items: start;
      gap: 32px;
      padding-top: 8px;
    }

    .memo-card {
      transform: rotate(0.6deg);
    }

    .hero-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      color: var(--muted);
      font-size: 0.82rem;
    }

    .tag-chip {
      transition: transform 180ms ease, border-color 180ms ease, background-color 180ms ease;
    }

    .tag-chip:hover {
      transform: translateY(-1px);
      border-color: rgba(37, 99, 235, 0.24);
      background: rgba(37, 99, 235, 0.08);
    }

    .article-hero .button {
      width: fit-content;
      margin-top: 4px;
    }

    @media (max-width: 820px) {
      .article-body {
        grid-template-columns: 1fr;
      }

      .memo-card {
        transform: none;
      }
    }
  </style>
</BaseLayout>
