---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/paths";
import { formatPostDate, getDisplayTags } from "../../lib/postMeta";

const posts = (await getCollection("posts"))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const tags = [...new Set(posts.flatMap((post) => getDisplayTags(post.data)))];
const featured = posts.filter((post) => post.data.featured).slice(0, 3);
const articleLikeSlugs = new Set(posts.filter((post) => post.data.kind === "writing").map((post) => post.slug));
const activityPosts = posts.filter((post) => !articleLikeSlugs.has(post.slug));
const articlePosts = posts.filter((post) => articleLikeSlugs.has(post.slug));
---

<BaseLayout title="Works | Portfolio" description="実績一覧です。">
  <section class="page-intro list-intro">
    <div>
      <p class="eyebrow">公開実績</p>
      <h1><span class="marker">実績一覧</span></h1>
    </div>
    <p class="speech lead">
        <svg class="speech-tail" aria-hidden="true" width="30" height="28" viewBox="0 0 30 28"><path d="M30 4 Q 14 8 1 3 Q 10 14 30 22" /></svg>
        <svg class="speech-lines" aria-hidden="true" width="26" height="26" viewBox="0 0 26 26"><path d="M4 16 L10 18" /><path d="M8 6 L13 13" /><path d="M19 2 L18 10" /></svg>
      インターン、研究室、個人開発で公開できる実績をまとめています。
    </p>
  </section>

  <section class="catalog-tools">
    <div class="filter-row">
      <button class="filter-button active" data-filter="all" aria-pressed="true">すべて</button>
      {tags.map((tag) => (
        <button class="filter-button" data-filter={tag} aria-pressed="false">#{tag}</button>
      ))}
    </div>
  </section>

  <section class="catalog-layout">
    <div class="work-ledger">
      <section class="archive-group">
        <h2 class="section-title">
          <span class="section-num">1</span>
          <span class="section-name">やったこと</span>
          <span class="eyebrow">参加したもの</span>
        </h2>
        <div class="group-ledger" id="post-list">
        {activityPosts.map((post) => (
          <div class="case-item" data-tags={JSON.stringify(getDisplayTags(post.data))}>
          <article class="ledger-row case-row" data-kind={post.data.kind}>
            <div class="ledger-row-main">
              <div class="meta-row">
                <time datetime={post.data.publishedAt.toISOString()}>
                  {formatPostDate(post.data)}
                </time>
              </div>
              <h2>
                <a href={withBase(`/posts/${post.slug}/`)}>{post.data.title}</a>
              </h2>
              <div class="tag-row">
                {getDisplayTags(post.data).map((tag) => (
                  <span class="pill neutral">{tag}</span>
                ))}
              </div>
            </div>
          </article>
          {post.data.role && (
            <p class="role-bubble">
              <svg class="role-tail" aria-hidden="true" width="26" height="22" viewBox="0 0 26 22"><path d="M3 22 Q 5 10 1 1 Q 13 9 21 22" /></svg>
              <svg class="role-lines" aria-hidden="true" width="18" height="18" viewBox="0 0 18 18"><path d="M2 8 L7 10" /><path d="M5 2 L9 7" /><path d="M12 1 L12 6" /></svg>
              <span class="role-label">担当</span>
              {post.data.role}
            </p>
          )}
          </div>
        ))}
        </div>
      </section>
      <section class="archive-group note-box">
        <span class="box-label">書いたもの</span>
        <h2 class="section-title">
          <span class="section-num">2</span>
          <span class="section-name">記事・ブログ</span>
        </h2>
        <div class="group-ledger">
        {articlePosts.map((post) => (
          <article class="ledger-row case-row article-row case-item" data-tags={JSON.stringify(getDisplayTags(post.data))} data-kind={post.data.kind}>
            <div class="ledger-row-main">
              <div class="meta-row">
                <time datetime={post.data.publishedAt.toISOString()}>
                  {formatPostDate(post.data)}
                </time>
              </div>
              <h2>
                <a href={withBase(`/posts/${post.slug}/`)}>{post.data.title}</a>
              </h2>
              <div class="tag-row">
                {getDisplayTags(post.data).map((tag) => (
                  <span class="pill neutral">{tag}</span>
                ))}
              </div>
            </div>
          </article>
        ))}
        </div>
      </section>
    </div>
    <aside class="catalog-sidebar">
      <section class="sidebar-block">
        <p class="eyebrow">最近追加</p>
        <div class="note-stack">
          {featured.map((post) => (
            <a class="mini-note" href={withBase(`/posts/${post.slug}/`)} data-kind={post.data.kind}>
              <strong>{post.data.title}</strong>
              <span>{formatPostDate(post.data)}</span>
            </a>
          ))}
        </div>
      </section>
    </aside>
  </section>

  <script>
    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".filter-button")
    );
    const cards = Array.from(document.querySelectorAll<HTMLElement>(".case-item"));

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.filter;
        buttons.forEach((item) => {
          item.classList.remove("active");
          item.setAttribute("aria-pressed", "false");
        });
        button.classList.add("active");
        button.setAttribute("aria-pressed", "true");

        cards.forEach((card) => {
          const rawTags = card.getAttribute("data-tags") || "[]";
          const tags = JSON.parse(rawTags) as string[];
          const visible = filter === "all" || tags.includes(filter || "");
          card.toggleAttribute("hidden", !visible);
        });
      });
    });
  </script>

  <style>
    .catalog-tools,
    .catalog-layout,
    .catalog-sidebar,
    .note-stack,
    .archive-group,
    .group-ledger {
      display: grid;
      gap: 16px;
    }

    .list-intro {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 20px 40px;
      padding: 18px 0;
    }

    .catalog-tools {
      gap: 10px;
    }

    .case-item {
      display: grid;
      gap: 14px;
    }

    .case-item + .case-item {
      margin-top: 18px;
    }

    .group-ledger .article-row + .article-row {
      margin-top: 0;
    }

    .catalog-layout {
      grid-template-columns: minmax(0, 1fr) 240px;
      align-items: start;
      gap: 22px;
    }

    .archive-group {
      gap: 18px;
    }

    .archive-group + .archive-group {
      margin-top: 36px;
    }

    .group-head {
      display: grid;
      gap: 4px;
      padding-bottom: 6px;
      border-bottom: 1px solid var(--line);
    }

    .catalog-sidebar {
      position: sticky;
      top: 24px;
    }

    .sidebar-block,
    .mini-note {
      display: grid;
      gap: 6px;
    }

    .sidebar-block {
      gap: 10px;
    }

    .note-stack {
      padding-top: 8px;
    }

    .mini-note {
      --tape-bg: var(--tape-intern-bg);
      --tape-border: var(--tape-intern-border);
      position: relative;
      padding: 22px 0 10px;
      border-bottom: 1px solid var(--line);
      transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
    }

    .mini-note::before {
      content: "";
      position: absolute;
      top: 8px;
      left: 6px;
      width: 36px;
      height: 11px;
      background: var(--tape-bg);
      border: 1px solid var(--tape-border);
      transform: rotate(-4deg);
    }

    .mini-note:nth-child(2n) {
      transform: rotate(-0.7deg);
    }

    .mini-note:nth-child(3n) {
      transform: rotate(0.7deg);
    }

    .mini-note span {
      color: var(--muted);
      font-size: 0.8rem;
    }

    .mini-note:hover {
      transform: translateX(2px) rotate(0deg);
    }

    .case-row {
      --pin-color: var(--tape-intern-bg);
      --pin-ring: var(--tape-intern-border);
      position: relative;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0.84));
      padding-top: 26px;
      transform-origin: center 18px;
    }

    .article-row {
      position: relative;
    }

    .case-row::before,
    .case-row::after {
      content: "";
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
    }

    .case-row::before {
      top: 8px;
      width: 14px;
      height: 14px;
      border-radius: 999px;
      background:
        radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.9), transparent 34%),
        var(--pin-color);
      border: 1px solid var(--pin-ring);
      box-shadow:
        0 2px 0 0 rgba(255, 255, 255, 0.55) inset,
        0 3px 8px var(--pin-metal-shadow);
      z-index: 2;
    }

    .case-row::after {
      top: 18px;
      width: 18px;
      height: 8px;
      border-radius: 999px;
      background:
        radial-gradient(circle at center, var(--pin-hole) 0 28%, transparent 72%);
      opacity: 0.9;
    }

    .case-row:nth-child(2n) {
      transform: rotate(-0.25deg);
    }

    .case-row:nth-child(3n) {
      transform: rotate(0.25deg);
    }

    .mini-note[data-kind="intern"] {
      --tape-bg: var(--tape-intern-bg);
      --tape-border: var(--tape-intern-border);
    }

    .case-row[data-kind="intern"] {
      --pin-color: var(--tape-intern-bg);
      --pin-ring: var(--tape-intern-border);
    }

    .mini-note[data-kind="lab"] {
      --tape-bg: var(--tape-lab-bg);
      --tape-border: var(--tape-lab-border);
    }

    .case-row[data-kind="lab"] {
      --pin-color: var(--tape-lab-bg);
      --pin-ring: var(--tape-lab-border);
    }

    .mini-note[data-kind="project"] {
      --tape-bg: var(--tape-project-bg);
      --tape-border: var(--tape-project-border);
    }

    .case-row[data-kind="project"] {
      --pin-color: var(--tape-project-bg);
      --pin-ring: var(--tape-project-border);
    }

    .mini-note[data-kind="writing"] {
      --tape-bg: var(--tape-writing-bg);
      --tape-border: var(--tape-writing-border);
    }

    .case-row[data-kind="writing"] {
      --pin-color: var(--tape-writing-bg);
      --pin-ring: var(--tape-writing-border);
    }

    @media (max-width: 820px) {
      .catalog-layout {
        grid-template-columns: 1fr;
      }

      .catalog-sidebar {
        position: static;
      }

      .mini-note:nth-child(2n),
      .mini-note:nth-child(3n) {
        transform: none;
      }

      .case-row:nth-child(2n),
      .case-row:nth-child(3n) {
        transform: none;
      }

    }
  </style>
</BaseLayout>
